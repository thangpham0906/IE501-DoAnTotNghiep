# Cấu hình Web Demo dịch máy Việt - Tày và thử nghiệm giọng nói

# Loại engine suy luận dịch: mock | pipeline
TRANSLATION_ENGINE_TYPE=mock
# Đường dẫn bundle mô hình (bắt buộc khi dùng pipeline)
# MODEL_BUNDLE_PATH=models/demo-bundle
MODEL_DEVICE=cpu

# Loại engine ASR: mock | whisper | disabled
ASR_ENGINE_TYPE=mock
# Đường dẫn weights Whisper cục bộ (bắt buộc khi dùng whisper)
# WHISPER_MODEL_PATH=models/asr/model.pt
ASR_DEVICE=cpu

# Giới hạn dữ liệu và bảo vệ tài nguyên
MAX_TEXT_LENGTH=1000
MAX_JSON_BODY_BYTES=65536
MAX_AUDIO_FILE_BYTES=10485760
MAX_MULTIPART_BODY_BYTES=11534336
MAX_AUDIO_DURATION_SEC=30

# Hàng đợi và worker suy luận
INFERENCE_WORKERS=1
MAX_QUEUED_INFERENCES=8
QUEUE_TIMEOUT_SEC=5.0
TRANSLATION_TIMEOUT_SEC=15.0
ASR_TIMEOUT_SEC=20.0
SHUTDOWN_GRACE_SEC=30.0

# Độ trễ giả lập cho mock (ms) - 0 khi chạy bình thường, >0 khi test concurrency
MOCK_DELAY_MS=0
